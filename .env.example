# cp .env.example .env

# --- Neo4j AuraDB ---
# Use values from the Aura credential download.
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# Aura credential files commonly call this NEO4J_USERNAME.
# The runtime also accepts NEO4J_USER for compatibility.
NEO4J_USERNAME=<username-from-aura-file>
NEO4J_PASSWORD=<password-from-aura-file>
NEO4J_DATABASE=<database-from-aura-file>

# --- Extraction / generation LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-...

# Optional Groq fallback
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM-as-a-Judge ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4.1-mini

# --- Hugging Face Access Token ---
HF_TOKEN=hf_...

# --- Official first-5000 run defaults ---
LAB_MAX_ARTICLES=5000
LAB_MAX_CHUNKS=12000
EXTRACTION_MAX_CHUNKS=12000
COREF_BATCH_SIZE=16
EXTRACT_BATCH_SIZE=16

# Set to 1 only for a dedicated lab DB when deleting existing :Entity nodes is safe.
LAB_RESET_GRAPH=0
